[project]
name = "embodied-ai-jobs"
requires = ["nodejs-24", "python-3.11"]

[dev]
build = ["sh", "-c", "cd apps/web && pnpm install && cd ../api && pip install -r requirements.txt"]
run = ["sh", "-c", "cd apps/api && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 & cd apps/web && pnpm run dev --port ${DEPLOY_RUN_PORT:-5000} --host 0.0.0.0"]

[deploy]
build = ["sh", "-c", "cd apps/web && pnpm install && pnpm run build"]
run = ["sh", "-c", "cd apps/api && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 & cd apps/web && pnpm run preview --port ${DEPLOY_RUN_PORT:-5000} --host 0.0.0.0"]
