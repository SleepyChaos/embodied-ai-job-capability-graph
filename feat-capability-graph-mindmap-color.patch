From 924e3535eba57553526f15d42dc20c52feb49f77 Mon Sep 17 00:00:00 2001
From: user2376060898 <2169772629561595-user2376060898@noreply.coze.cn>
Date: Tue, 21 Jul 2026 17:58:38 +0800
Subject: [PATCH 15/18] =?UTF-8?q?fix:=20=E4=BF=AE=E5=A4=8DGraphCanvas?=
 =?UTF-8?q?=E5=BC=82=E6=AD=A5=E5=9B=9E=E8=B0=83=E4=B8=ADgraph=E6=9C=AA?=
 =?UTF-8?q?=E5=AE=9A=E4=B9=89=E9=94=99=E8=AF=AF=EF=BC=8C=E6=94=B9=E7=94=A8?=
 =?UTF-8?q?graphRef.current?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 apps/web/src/components/GraphCanvas.tsx | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/apps/web/src/components/GraphCanvas.tsx b/apps/web/src/components/GraphCanvas.tsx
index 46f7359..a682f86 100644
--- a/apps/web/src/components/GraphCanvas.tsx
+++ b/apps/web/src/components/GraphCanvas.tsx
@@ -232,23 +232,23 @@ export const GraphCanvas = forwardRef(function GraphCanvas(props: Props, ref: Re
 
       // Listen for afterlayout to restore selection + fitView
       afterLayoutOffRef.current = graph.on("afterlayout", () => {
-        if (disposed) return;
+        if (disposed || !graphRef.current) return;
         const selectedId = selectedIdRef.current;
         if (selectedId && visibleNodeIdsRef.current.has(selectedId)) {
-          void graph.setElementState(selectedId, "selected");
+          void graphRef.current.setElementState(selectedId, "selected");
           previousSelectedIdRef.current = selectedId;
         }
-        void graph.fitView({ when: "always" });
+        void graphRef.current.fitView({ when: "always" });
       });
 
       void graph.render().then(() => {
-        if (disposed) return;
+        if (disposed || !graphRef.current) return;
         const selectedId = selectedIdRef.current;
         if (selectedId && visibleNodeIdsRef.current.has(selectedId)) {
-          void graph.setElementState(selectedId, "selected");
+          void graphRef.current.setElementState(selectedId, "selected");
           previousSelectedIdRef.current = selectedId;
         }
-        void graph.fitView({ when: "always" });
+        void graphRef.current.fitView({ when: "always" });
       });
 
       // Extra multi-stage fitView for slow layouts (d3-force)
